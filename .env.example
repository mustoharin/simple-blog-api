# Server Configuration
PORT=8080
ENV=development

# Database
DATABASE_URL=postgres://bloguser:blogpass@localhost:5432/blogapi?sslmode=disable

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=720h

# S3 Storage (MinIO for local development)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=blog-images
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Email Configuration (optional, leave empty for development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com

# Captcha Configuration (optional, leave empty for development)
CAPTCHA_PROVIDER=hcaptcha
CAPTCHA_SECRET=
CAPTCHA_SITE_KEY=

# CORS Configuration
ALLOWED_ORIGINS=*
FRONTEND_URL=http://localhost:3000

# Data Retention
AUDIT_LOG_RETENTION_DAYS=365
SOFT_DELETE_RETENTION_DAYS=90
